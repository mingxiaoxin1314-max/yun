---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100/90 border-t border-slate-200 text-slate-600 text-sm mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: About -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-6 h-6 rounded-lg bg-slate-900 border border-slate-800 p-0.5 flex items-center justify-center">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none">
              <path d="M16 46L26 46L30 40L20 40Z" fill="#0d9488" opacity="0.65"/>
              <path d="M22 38L32 38L36 32L26 32Z" fill="#14b8a6" opacity="0.85"/>
              <path d="M28 30L38 30L44 20L34 20Z" fill="#2dd4bf"/>
              <path d="M35 21L45 21L50 14L40 14Z" fill="#38bdf8"/>
              <path d="M17 46L39 14" stroke="#34d399" stroke-width="3" stroke-linecap="round"/>
              <path d="M27 46L49 14" stroke="#38bdf8" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
