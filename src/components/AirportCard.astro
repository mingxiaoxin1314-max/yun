---
interface Props {
  rank: number;
  name: string;
  tagline: string;
  badge?: string;
  speed: string;
  latency: string;
  protocols: string[];
  price: string;
  features: string[];
  affUrl: string;
  coupon?: string;
  established?: string;
  packageDetail?: string;
  lineType?: string;
}

const {
  rank,
  name,
  tagline,
  badge,
  speed,
  latency,
  protocols,
  price,
  features,
  affUrl,
  coupon,
  established,
  packageDetail,
  lineType
} = Astro.props;

const rankColors: Record<number, string> = {
  1: 'bg-amber-400 text-slate-950 font-black ring-4 ring-amber-400/20',
  2: 'bg-slate-200 text-slate-800 font-bold ring-2 ring-slate-300',
  3: 'bg-amber-100 text-amber-900 border border-amber-300 font-bold',
};
const defaultRankColor = 'bg-slate-100 text-slate-700 font-bold';
---

<div class="relative rounded-2xl bg-white border border-slate-200 p-6 hover:border-teal-500/70 transition-all duration-300 group shadow-sm hover:shadow-md flex flex-col justify-between">
  <div>
    <!-- Top Floating Badge -->
    {badge && (
      <div class="absolute -top-3 right-6 px-3 py-1 text-[11px] font-bold rounded-full bg-gradient-to-r from-teal-600 to-emerald-600 text-white shadow-sm uppercase tracking-wider">
        {badge}
      </div>
    )}

    <!-- Header Section -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3">
        <div class={`w-8 h-8 rounded-lg flex items-center justify-center text-sm shrink-0 ${rankColors[rank] || defaultRankColor}`}>
          #{rank}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-teal-600 transition-colors">
              {name}
            </h3>
            {established && (
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono">
                {established}年
              </span>
            )}
          </div>
          <p class="text-xs text-slate-500 mt-0.5 line-clamp-1">{tagline}</p>
        </div>
      </div>
      <div class="text-right shrink-0">
        <div class="text-lg font-black text-teal-600">{price}</div>
        <div class="text-[10px] text-slate-400">起步方案</div>
      </div>
    </div>

    <!-- Package Detail Strip -->
    {packageDetail && (
      <div class="text-[11px] text-slate-600 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200/70 my-3 leading-relaxed">
        <span class="font-bold text-slate-700">套餐规格：</span>{packageDetail}
      </div>
    )}

    <!-- Benchmarks Grid -->
    <div class="grid grid-cols-2 gap-3 my-3 p-3 rounded-xl bg-slate-50 border border-slate-200/80">
      <div class="flex flex-col">
        <span class="text-[11px] text-slate-500">晚高峰实测带宽</span>
        <span class="text-sm font-bold text-emerald-700 font-mono">{speed}</span>
      </div>
      <div class="flex flex-col">
        <span class="text-[11px] text-slate-500">平均延迟 (Ping)</span>
        <span class="text-sm font-bold text-teal-700 font-mono">{latency}</span>
      </div>
    </div>

    <!-- Features list -->
    <ul class="space-y-1.5 my-3 text-xs text-slate-600">
      {features.map((feat) => (
        <li class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="line-clamp-1">{feat}</span>
        </li>
      ))}
    </ul>

    <!-- Coupon Badge -->
    {coupon && coupon !== '—' && (
      <div class="my-3 flex items-center justify-between px-3 py-1.5 rounded-lg bg-amber-50/80 border border-amber-200/80 text-xs">
        <span class="text-amber-800 font-medium">专属优惠码:</span>
        <code class="font-mono font-bold text-amber-900 bg-amber-100/80 px-2 py-0.5 rounded select-all cursor-pointer" title="点击选中并复制">
          {coupon}
        </code>
      </div>
    )}

    <!-- Protocol tags -->
    <div class="flex flex-wrap gap-1.5 my-3">
      {lineType && (
        <span class="px-2 py-0.5 rounded bg-teal-50 text-[10px] font-bold text-teal-700 border border-teal-200">
          {lineType}
        </span>
      )}
      {protocols.map((proto) => (
        <span class="px-2 py-0.5 rounded bg-slate-100 text-[10px] font-mono text-slate-700 border border-slate-200/80">
          {proto}
        </span>
      ))}
    </div>
  </div>

  <!-- Action Button with strict compliance attributes -->
  <a 
    href={affUrl}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class="w-full mt-4 py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-teal-600 text-white text-center font-bold text-xs transition-all flex items-center justify-center gap-2 group/btn shadow-sm"
  >
    <span>直达官网测速与选购</span>
    <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>
