---
interface Props {
  rank: number;
  name: string;
  tagline: string;
  badge?: string;
  speed: string;
  latency: string;
  protocols: string[];
  price: string;
  features: string[];
  affUrl: string;
}

const {
  rank,
  name,
  tagline,
  badge,
  speed,
  latency,
  protocols,
  price,
  features,
  affUrl
} = Astro.props;

const rankColors: Record<number, string> = {
  1: 'bg-amber-400 text-slate-950 font-black ring-4 ring-amber-400/20',
  2: 'bg-slate-300 text-slate-950 font-bold',
  3: 'bg-amber-700 text-amber-100 font-bold',
};
const defaultRankColor = 'bg-slate-800 text-slate-300';
---

<div class="relative rounded-2xl bg-slate-900 border border-slate-800 p-6 hover:border-teal-500/50 transition-all duration-300 group shadow-lg">
  {badge && (
    <div class="absolute -top-3 right-6 px-3 py-1 text-[11px] font-bold rounded-full bg-gradient-to-r from-teal-500 to-emerald-400 text-slate-950 shadow-md uppercase tracking-wider">
      {badge}
    </div>
  )}

  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="flex items-center gap-3">
      <div class={`w-8 h-8 rounded-lg flex items-center justify-center text-sm ${rankColors[rank] || defaultRankColor}`}>
        #{rank}
      </div>
      <div>
        <h3 class="text-xl font-bold text-white group-hover:text-teal-300 transition-colors">
          {name}
        </h3>
        <p class="text-xs text-slate-400">{tagline}</p>
      </div>
    </div>
    <div class="text-right">
      <div class="text-lg font-black text-teal-400">{price}</div>
      <div class="text-[10px] text-slate-400">起步月付/套餐</div>
    </div>
  </div>

  <!-- Benchmarks Grid -->
  <div class="grid grid-cols-2 gap-3 my-4 p-3 rounded-xl bg-slate-950/70 border border-slate-800/80">
    <div class="flex flex-col">
      <span class="text-[11px] text-slate-400">晚高峰实测带宽</span>
      <span class="text-sm font-bold text-emerald-400 font-mono">{speed}</span>
    </div>
    <div class="flex flex-col">
      <span class="text-[11px] text-slate-400">平均延迟 (Ping)</span>
      <span class="text-sm font-bold text-teal-300 font-mono">{latency}</span>
    </div>
  </div>

  <!-- Features list -->
  <ul class="space-y-1.5 my-4 text-xs text-slate-300">
    {features.map((feat) => (
      <li class="flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>{feat}</span>
      </li>
    ))}
  </ul>

  <!-- Protocol tags -->
  <div class="flex flex-wrap gap-1.5 mb-5">
    {protocols.map((proto) => (
      <span class="px-2 py-0.5 rounded bg-slate-800 text-[10px] font-mono text-slate-300 border border-slate-700/60">
        {proto}
      </span>
    ))}
  </div>

  <!-- Action Button with strict compliance attributes -->
  <a 
    href={affUrl}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-teal-500 hover:text-slate-950 text-slate-200 text-center font-bold text-xs transition-all flex items-center justify-center gap-2 group/btn"
  >
    <span>直达官网测速与选购</span>
    <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>
