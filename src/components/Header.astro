---
const navItems = [
  { label: '首页推荐', href: '/' },
  { label: '机场测速榜', href: '/#ranking' },
  { label: '技术专栏库', href: '/posts/' },
  { label: '协议评测', href: '/posts/vless-hysteria2-tuic-protocols/' },
  { label: '避坑FAQ', href: '/#faq' },
  { label: '关于本站', href: '/about/' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 text-slate-800 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 p-1 flex items-center justify-center shadow-md shadow-teal-500/10 group-hover:scale-105 transition-all">
        <svg class="w-full h-full" viewBox="0 0 64 64" fill="none">
          <defs>
            <linearGradient id="nav-rail-l" x1="17" y1="46" x2="39" y2="14" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#059669"/>
              <stop offset="100%" stop-color="#34d399"/>
            </linearGradient>
            <linearGradient id="nav-rail-r" x1="27" y1="46" x2="49" y2="14" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#0284c7"/>
              <stop offset="100%" stop-color="#38bdf8"/>
            </linearGradient>
          </defs>
          <path d="M16 46L26 46L30 40L20 40Z" fill="#0d9488" opacity="0.65"/>
          <path d="M22 38L32 38L36 32L26 32Z" fill="#14b8a6" opacity="0.85"/>
          <path d="M28 30L38 30L44 20L34 20Z" fill="#2dd4bf"/>
          <path d="M35 21L45 21L50 14L40 14Z" fill="#38bdf8"/>
          <path d="M17 46L39 14" stroke="url(#nav-rail-l)" stroke-width="2.8" stroke-linecap="round"/>
          <path d="M27 46L49 14" stroke="url(#nav-rail-r)" stroke-width="2.8" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-black tracking-tight text-slate-900 group-hover:text-teal-600 transition-colors">
          云机场 <span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-teal-50 text-teal-700 border border-teal-200/80 ml-1">VIP</span>
        </span>
        <span class="text-[10px] text-slate-500 tracking-wider font-mono">yunjichang.vip</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-slate-600 hover:text-teal-600 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Quick CTA -->
    <div class="flex items-center gap-3">
      <a 
        href="/#ranking" 
        class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold rounded-lg bg-teal-600 hover:bg-teal-700 text-white transition-all shadow-md shadow-teal-600/20 hover:shadow-teal-600/30"
      >
        <span>实时测速榜单</span>
      </a>
    </div>
  </div>
</header>

