          href="/posts/" 
          class="px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-bold text-sm transition-colors border border-slate-300 shadow-sm flex items-center gap-2"
        >
          <span>技术评测专栏库</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200/80">{posts.length}篇</span>
        </a>
