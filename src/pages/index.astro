    </section>

    <!-- Essential Selection Criteria (Topic Authority for Bing) -->
    <section class="my-16 p-8 rounded-3xl bg-slate-100/70 border border-slate-200">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          新手选购机场梯子的 <span class="text-teal-700">4 大避坑黄金法则</span>
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          掌握这四条核心逻辑，能帮你避开 95% 以上的劣质割韭菜跑路站。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-teal-50 border border-teal-200/80 text-teal-700 flex items-center justify-center font-bold text-base mb-3 font-mono">01</div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">线路类型优先选专线 (IPLC/IEPL)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            直连线路每逢特殊时期或晚高峰极易大面积阻断。IPLC 是企业级内网专线光纤，境内到境外机房不过公网大防火墙，不惧封锁，延迟和丢包表现极其优异。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center font-bold text-base mb-3 font-mono">02</div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">坚决坚持「月付」或「季付」</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            不论机场吹嘘得多么天花乱坠、年付折扣多么诱人，永远不要一次性上车超长年付套餐。按月订阅即使遇到突发不可抗力也能将试错损失降到最低。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-cyan-50 border border-cyan-200/80 text-cyan-700 flex items-center justify-center font-bold text-base mb-3 font-mono">03</div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">检查协议多样性 (Hysteria 2 / VLESS)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            优质机场必须支持新一代协议。传统 Shadowsocks 容易在恶劣公网下被精准识别降速，而 Hysteria 2、Reality 可以在恶劣弱网下依然保持高吞吐和强伪装。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-amber-50 border border-amber-200/80 text-amber-700 flex items-center justify-center font-bold text-base mb-3 font-mono">04</div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">永远准备 1 个冷备用节点</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            鸡蛋不要放在一个篮子里。在主力高速专线机场之外，务必配置一个按量计费的轻量备用订阅，避免主力机场维护时出现彻底失联的窘境。
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Guides (Compact Lightweight Topic Anchor) -->
    <section id="tutorials" class="my-10 p-6 sm:p-7 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-teal-50 border border-teal-200/80 flex items-center justify-center text-teal-700">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
              精选技术专栏与上手指南
            </h2>
            <p class="text-xs text-slate-500">
              全平台客户端上手、专线底层解析与流媒体解锁实测
            </p>
          </div>
        </div>

        <a 
          href="/posts/" 
          class="text-xs font-bold text-teal-600 hover:text-teal-700 flex items-center gap-1 group self-start sm:self-auto bg-teal-50/70 hover:bg-teal-100/60 border border-teal-200/60 px-3 py-1.5 rounded-lg transition-colors"
        >
          <span>进入专栏库查看全部 ({posts.length} 篇)</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Compact 3-Column Strip -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 mt-4">
        {posts.slice(0, 3).map((post) => (
          <a 
            href={`/posts/${post.id}/`}
            class="group p-3.5 rounded-xl bg-slate-50 hover:bg-teal-50/40 border border-slate-200/70 hover:border-teal-500/50 transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                {post.data.badge && (
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-teal-100/80 text-teal-800">
                    {post.data.badge}
                  </span>
                )}
                <span class="text-[11px] text-slate-400 font-mono">
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </span>
              </div>
              <h3 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-teal-600 transition-colors line-clamp-2 leading-snug">
                {post.data.title}
              </h3>
            </div>
            <div class="mt-2.5 flex items-center gap-1 text-[11px] font-semibold text-teal-600 group-hover:text-teal-700">
              <span>阅读指南</span>
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <FaqSection />
  </div>
</Layout>
