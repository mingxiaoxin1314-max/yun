  keywords="机场推荐, 梯子, 机场测速, 2026机场推荐, 科学上网, Clash节点, VLESS, Hysteria2, IPLC专线, 梯子推荐, 云机场, yunjichang.vip"
  schema={[itemListSchema, faqSchema]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-14 pb-16 border-b border-slate-200 bg-gradient-to-b from-teal-50/50 via-slate-50 to-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(13,148,136,0.08),transparent_60%)] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative z-10">
